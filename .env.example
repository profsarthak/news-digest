# Copy to .env.local and fill in. .env.local is gitignored.

# --- Required to compile ---------------------------------------------------

# Anthropic API key (server-side only) — used by the daily compile pipeline.
ANTHROPIC_API_KEY=

# Guards the /api/cron/compile endpoint so only you can trigger API spend.
# (Any random string. Also how Vercel Cron would authenticate, if used.)
CRON_SECRET=dev-secret-change-me

# --- Storage ---------------------------------------------------------------

# Neon Postgres connection string. Leave BLANK to store digests as local JSON
# files under .data/ (handy for local development).
DATABASE_URL=

# --- Optional overrides (defaults live in code) ----------------------------

# Models (see lib/anthropic.ts).
DIGEST_MODEL=claude-sonnet-4-6
RESEARCH_MODEL=claude-haiku-4-5
OPED_MODEL=claude-haiku-4-5

# How many top topics get paid web-search context/implications (0 = none).
TOP_RESEARCHED=4

# Number of op-eds per day.
OPED_COUNT=4
